# DRAPE Backend Configuration Template
PROJECT_NAME="DRAPE API"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Server
HOST="0.0.0.0"
PORT=8000

# CORS (comma-separated origins)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Database (PostgreSQL with asyncpg driver)
# For local dev: postgresql+asyncpg://<username>:<password>@localhost:5432/<database>
DATABASE_URL="postgresql+asyncpg://drape_app:REPLACE_WITH_DEV_DB_PASSWORD@localhost:5432/drape_db"
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# Administrative API Key (for seed / privileged operations)
# Generate with: openssl rand -hex 32
ADMIN_API_KEY="REPLACE_WITH_A_RANDOM_ADMIN_KEY_MIN_32_CHARS"

# Authentication & JWT Security Settings
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY="REPLACE_WITH_A_RANDOM_SECRET_KEY_MIN_32_CHARS"
JWT_ALGORITHM="HS256"
JWT_ISSUER="drape-auth"
JWT_AUDIENCE="drape-client"
JWT_LEEWAY_SECONDS=10
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Razorpay Payment Gateway Settings (Placeholders only)
RAZORPAY_KEY_ID="rzp_test_YOUR_RAZORPAY_TEST_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_TEST_KEY_SECRET"
RAZORPAY_WEBHOOK_SECRET="YOUR_RAZORPAY_WEBHOOK_SECRET"
PAYMENT_PROVIDER="razorpay"

# Commerce, Shipping & Tax Defaults
DEFAULT_TAX_RATE=0.0825
FREE_SHIPPING_THRESHOLD=500.00
PENDING_ORDER_EXPIRATION_MINUTES=30

# Logging
LOG_LEVEL="INFO"
LOG_FORMAT="json"
