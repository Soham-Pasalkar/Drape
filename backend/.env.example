# DRAPE Backend Configuration
PROJECT_NAME="DRAPE API"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Server
HOST="0.0.0.0"
PORT=8000

# CORS (comma-separated origins)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Database (PostgreSQL with asyncpg driver)
DATABASE_URL="postgresql+asyncpg://drape_app:drape_dev_password@localhost:5432/drape_db"
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# Administrative API Key (for seed / privileged operations)
ADMIN_API_KEY="drape-admin-dev-secret-key-32b"

# Authentication & JWT Security Settings
JWT_SECRET_KEY="drape-fashion-secret-key-development-minimum-32-bytes-secure"
JWT_ALGORITHM="HS256"
JWT_ISSUER="drape-auth"
JWT_AUDIENCE="drape-client"
JWT_LEEWAY_SECONDS=10
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Razorpay Payment Gateway Settings (Placeholders only)
RAZORPAY_KEY_ID="rzp_test_placeholder_key_id"
RAZORPAY_KEY_SECRET="placeholder_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="placeholder_razorpay_webhook_secret"
PAYMENT_PROVIDER="razorpay"

# Commerce, Shipping & Tax Defaults
DEFAULT_TAX_RATE=0.0825
FREE_SHIPPING_THRESHOLD=500.00
PENDING_ORDER_EXPIRATION_MINUTES=30

# Logging
LOG_LEVEL="INFO"
LOG_FORMAT="json"
