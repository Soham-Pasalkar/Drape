# DRAPE Backend Configuration
PROJECT_NAME="DRAPE API"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Server
HOST="0.0.0.0"
PORT=8000

# CORS (comma-separated origins)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Database (PostgreSQL with asyncpg driver)
# For local dev without a running postgres container, the app starts cleanly
# and /healthz succeeds; /readyz reports disconnected until database is up.
DATABASE_URL="postgresql+asyncpg://drape_app:drape_dev_password@localhost:5432/drape_db"
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# Logging
LOG_LEVEL="INFO"
LOG_FORMAT="json"

