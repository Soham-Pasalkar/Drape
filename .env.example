# DRAPE Platform Environment Configuration Template

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="DRAPE"

# Backend Core
PROJECT_NAME="DRAPE API"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true
HOST="0.0.0.0"
PORT=8000
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# PostgreSQL Database (asyncpg driver)
# For local development: postgresql+asyncpg://<username>:<password>@localhost:5432/<database>
DATABASE_URL="postgresql+asyncpg://drape_app:REPLACE_WITH_DEV_DB_PASSWORD@localhost:5432/drape_db"
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# Authentication & Security
# Generate secure random keys with: openssl rand -hex 32
JWT_SECRET_KEY="REPLACE_WITH_A_RANDOM_SECRET_KEY_MIN_32_CHARS"
ADMIN_API_KEY="REPLACE_WITH_A_RANDOM_ADMIN_KEY_MIN_32_CHARS"

# Logging
LOG_LEVEL="INFO"
LOG_FORMAT="json"
