# DRAPE Platform Environment Configuration (Milestone 1)

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="DRAPE"

# Backend Core
PROJECT_NAME="DRAPE API"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true
HOST="0.0.0.0"
PORT=8000
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# PostgreSQL Database (asyncpg)
DATABASE_URL="postgresql+asyncpg://drape_app:drape_dev_password@localhost:5432/drape_db"
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# Logging
LOG_LEVEL="INFO"
LOG_FORMAT="json"

